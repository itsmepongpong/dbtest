<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:padding="16dp">


        <!-- Everything that should zoom in/out lives inside this container. -->

        <RelativeLayout
            android:id="@+id/mapContent"
            android:layout_width="368dp"
            android:layout_height="686dp"
            android:layout_marginTop="-16dp"
            android:clipChildren="false">


            <Button
                android:id="@+id/btn_1b_block"
                android:layout_width="110dp"
                android:layout_height="116dp"
                android:layout_above="@+id/btn_2a_block"
                android:layout_marginLeft="50dp"
                android:layout_marginTop="50dp"
                android:layout_marginBottom="361dp"
                android:background="@drawable/building"
                android:text="1B"
                android:textColor="#F2F4F7"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_1a_block"
                android:layout_width="110dp"
                android:layout_height="59dp"
                android:layout_alignEnd="@+id/btn_1b_block"
                android:layout_marginTop="50dp"
                android:layout_marginEnd="-172dp"
                android:background="@drawable/building"
                android:text="1A"
                android:textColor="#F2F4F7"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_2a_block"
                android:layout_width="114dp"
                android:layout_height="61dp"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="45dp"
                android:layout_marginBottom="82dp"
                android:layout_toStartOf="@+id/btn_2b_block"
                android:background="@drawable/building"
                android:text="2A"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_2b_block"
                android:layout_width="114dp"
                android:layout_height="61dp"
                android:layout_alignEnd="@+id/btn_1b_block"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="-149dp"
                android:layout_marginBottom="83dp"
                android:background="@drawable/building"
                android:text="2B"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />


            <Button
                android:id="@+id/btn_4_block"
                android:layout_width="71dp"
                android:layout_height="116dp"
                android:layout_above="@+id/btn_2b_block"
                android:layout_alignEnd="@+id/btn_1a_block"
                android:layout_marginTop="110dp"
                android:layout_marginEnd="0dp"
                android:layout_marginBottom="285dp"
                android:background="@drawable/building"
                android:text="Comp Lab"
                android:textColor="@color/white"
                android:textSize="14dp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_3_block"
                android:layout_width="71dp"
                android:layout_height="132dp"
                android:layout_above="@+id/btn_2b_block"
                android:layout_alignEnd="@+id/btn_1a_block"
                android:layout_marginTop="220dp"
                android:layout_marginEnd="0dp"
                android:layout_marginBottom="80dp"
                android:background="@drawable/building"
                android:text="Internet Room"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/floatingActionButton"
                android:layout_width="395dp"
                android:layout_height="537dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="24dp"
                android:clickable="true"
                android:contentDescription="@string/add_item"
                android:focusable="true"
                android:src="@drawable/settings_logo"
                android:tint="@color/purple_500"
                android:tintMode="add" />

        </RelativeLayout>

    </RelativeLayout>

    <!-- The slider is a self-contained layer. Added an ID so View Binding can find it cleanly. -->
    <include
        android:id="@+id/slider_root"
        layout="@layout/slider" />

</FrameLayout>