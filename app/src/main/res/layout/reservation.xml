<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Room Reservation"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#BB86FC"
            android:layout_marginBottom="24dp" />

        <!-- Building Name (Passed from previous screen) -->
        <TextView
            android:id="@+id/tv_building_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Building: "
            android:textSize="16sp"
            android:textColor="#000000"
            android:layout_marginBottom="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="24dp" />

        <!-- Date -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Date"
            android:inputType="date"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Start Time -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start Time"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_start_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="time"
            android:hint="Time"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- End Time -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="End Time"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_end_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputMethod="time"
            android:hint="Time"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Existing bookings for the selected date - filled in after you pick a date -->
        <TextView
            android:id="@+id/tv_existing_slots_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Already reserved on this date:"
            android:textSize="13sp"
            android:textStyle="italic"
            android:textColor="#999999"
            android:visibility="gone"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/ll_existing_slots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp" />

        <!-- Purpose/Notes -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Purpose"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_purpose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter purpose of reservation"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:gravity="top"
            android:layout_marginBottom="24dp" />

        <!-- Submit Button -->
        <Button
            android:id="@+id/btn_submit_reservation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Submit Reservation"
            android:backgroundTint="#BB86FC"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="12dp" />

        <!-- Cancel Button -->
        <Button
            android:id="@+id/btn_cancel_reservation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:backgroundTint="#E0E0E0"
            android:textColor="#000000"
            android:textSize="16sp"
            android:padding="12dp"
            android:layout_marginTop="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp" />

        <!-- Manage this room's existing bookings: cancel, or mark done for early dismissal -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manage This Room's Bookings"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_no_bookings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No active bookings for this room."
            android:textSize="14sp"
            android:textColor="#999999"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/ll_manage_reservations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>